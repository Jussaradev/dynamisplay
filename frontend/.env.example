# Copie este arquivo para ".env" (na pasta frontend) e preencha.
# No Vercel, cadastre estas mesmas variáveis em Settings > Environment Variables.

# Endereço do backend. No seu computador: http://localhost:5000
# Na nuvem: o endereço que o Render te der (ex.: https://dynamisplay-api.onrender.com)
VITE_API_URL=http://localhost:5000

# Mesmo Client ID do Google usado no backend
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
